---
import { tools } from "../data/tools";
import OpensInNewTab from "./OpensInNewTab.astro";

const [flagship, ...peers] = tools;
---
<section id="tools" class="section tools-section" aria-labelledby="tools-heading">
  <div class="container">
    <div class="tools-header">
      <h2 id="tools-heading" class="section-title">The tools</h2>
      <p class="section-subtitle">
        Start with the map. Everything else is a peer project by students, for
        students.
      </p>
    </div>

    <article class="flagship card" aria-labelledby="flagship-title">
      <a
        href={flagship.href}
        target="_blank"
        rel="noopener noreferrer"
        class="flagship__preview"
        aria-label={`Open ${flagship.name}`}
        tabindex="-1"
      >
        <img
          src={flagship.screenshot}
          alt={flagship.screenshotAlt}
          width="1807"
          height="973"
          decoding="async"
          fetchpriority="high"
        />
      </a>
      <div class="flagship__body">
        <div class="tool-tags" aria-label="Categories">
          {flagship.tags.map((tag) => <span class="badge">{tag}</span>)}
          <span class="badge badge-green">{flagship.statusLabel}</span>
        </div>
        <h3 id="flagship-title" class="flagship__title">{flagship.name}</h3>
        <p class="flagship__desc">{flagship.description}</p>
        {
          flagship.stats ? (
            <dl class="flagship__stats">
              {flagship.stats.map((stat) => (
                <div class="stat">
                  <dt>{stat.label}</dt>
                  <dd>{stat.value}</dd>
                </div>
              ))}
            </dl>
          ) : null
        }
        {flagship.note ? <p class="flagship__note">{flagship.note}</p> : null}
        <div class="tool-actions">
          <a
            href={flagship.href}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary"
          >
            {flagship.actionLabel}
            <OpensInNewTab />
          </a>
          {
            flagship.githubHref ? (
              <a
                href={flagship.githubHref}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-secondary"
                aria-label={`${flagship.name} source on GitHub`}
              >
                GitHub
                <OpensInNewTab />
              </a>
            ) : null
          }
        </div>
      </div>
    </article>

    <ul class="peers">
      {
        peers.map((tool) => (
          <li class="peer card">
            <div class="tool-tags" aria-label="Categories">
              {tool.tags.map((tag) => (
                <span class="badge">{tag}</span>
              ))}
              <span
                class={`badge ${tool.statusLabel === "Active" ? "badge-green" : "badge-maroon"}`}
              >
                {tool.statusLabel}
              </span>
            </div>
            <h3 class="peer__title">{tool.name}</h3>
            <p class="peer__desc">{tool.description}</p>
            <div class="tool-actions">
              <a
                href={tool.href}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-primary btn-sm"
              >
                {tool.actionLabel}
                <OpensInNewTab />
              </a>
              {tool.githubHref ? (
                <a
                  href={tool.githubHref}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-secondary btn-sm"
                  aria-label={`${tool.name} source on GitHub`}
                >
                  GitHub
                  <OpensInNewTab />
                </a>
              ) : null}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .tools-header {
    margin-bottom: 1.5rem;
  }

  .tool-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .tool-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }

  /* Flagship */
  .flagship {
    display: grid;
    grid-template-columns: 1fr;
    overflow: hidden;
    margin-bottom: 1rem;
  }

  .flagship__preview {
    display: block;
    border-bottom: 1px solid var(--border-card);
    background: var(--bg-elevated);
  }

  .flagship__preview img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1807 / 973;
    object-fit: cover;
  }

  .flagship__body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem;
  }

  .flagship__title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.1;
  }

  .flagship__desc {
    font-size: 1rem;
  }

  .flagship__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
    margin: 0.25rem 0;
  }

  .stat {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.1rem;
    padding: 0.75rem 0.5rem;
    border-radius: var(--radius-sm);
    background: var(--bg-elevated);
    border: 1px solid var(--border-card);
  }

  .stat dd {
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 3vw, 1.5rem);
    font-weight: 800;
    color: var(--brand-maroon);
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .stat dt {
    font-size: 0.75rem;
    color: var(--text-muted);
    line-height: 1.3;
  }

  .flagship__note {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  /* Peers */
  .peers {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    padding: 0;
    margin: 0;
  }

  .peer {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.25rem;
  }

  .peer__title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.2;
  }

  .peer__desc {
    font-size: 0.9375rem;
  }

  @media (min-width: 640px) {
    .peers {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 900px) {
    .flagship {
      grid-template-columns: 1.15fr 1fr;
    }

    .flagship__preview {
      border-bottom: none;
      border-right: 1px solid var(--border-card);
    }

    .flagship__preview img {
      height: 100%;
      aspect-ratio: auto;
      object-position: left top;
    }

    .flagship__body {
      padding: 1.75rem;
    }

    .peers {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
