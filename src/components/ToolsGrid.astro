---
import { tools } from "../data/tools";
import OpensInNewTab from "./OpensInNewTab.astro";
---
<section id="tools" class="dir-section" aria-labelledby="tools-heading">
  <div class="container">
    <h2 id="tools-heading" class="index-head">Tool index</h2>

    <ul class="dir" role="list">
      {
        tools.map((tool) => (
          <li class:list={["dir-row", { "dir-row--flagship": tool.flagship }]}>
            <a
              class="dir-row__thumb"
              href={tool.href}
              target="_blank"
              rel="noopener noreferrer"
              tabindex="-1"
              aria-hidden="true"
            >
              <img
                src={tool.screenshot}
                alt={tool.screenshotAlt}
                width="640"
                height="400"
                loading="lazy"
                decoding="async"
              />
            </a>
            <div class="dir-row__body">
              <h3 class="dir-row__name">
                {tool.name}
                <span
                  class:list={[
                    "badge",
                    tool.status === "live" ? "badge-green" : "badge-maroon",
                  ]}
                >
                  {tool.statusLabel}
                </span>
              </h3>
              <p class="dir-row__desc">{tool.description}</p>
              {tool.stats ? (
                <p class="dir-row__stats">{tool.stats.join(" · ")}</p>
              ) : null}
              <p class="dir-row__actions">
                <a
                  href={tool.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="tlink"
                >
                  {tool.actionLabel}&nbsp;↗
                  <OpensInNewTab />
                </a>
                {tool.githubHref ? (
                  <a
                    href={tool.githubHref}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="tlink"
                    aria-label={`${tool.name} source on GitHub`}
                  >
                    GitHub&nbsp;↗
                    <OpensInNewTab />
                  </a>
                ) : null}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .dir-section {
    padding: var(--space-xl) 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .dir {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .dir-row {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: var(--space-md);
    padding: var(--space-md) 0;
    border-top: 1px solid var(--border-subtle);
    align-items: start;
  }

  .dir-row--flagship {
    grid-template-columns: 16rem minmax(0, 1fr);
  }

  .dir-row__thumb img {
    display: block;
    width: 100%;
    max-width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: center;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    background: var(--bg-panel);
  }

  .dir-row__name {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-xl);
    line-height: 1.2;
    margin-bottom: var(--space-3xs);
  }

  .dir-row--flagship .dir-row__name {
    font-size: var(--text-2xl);
  }

  .dir-row__desc {
    font-size: var(--text-sm);
    max-width: 40rem;
    margin-bottom: var(--space-3xs);
  }

  .dir-row__stats {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-bottom: var(--space-3xs);
  }

  .dir-row__actions {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--space-md);
  }

  @media (max-width: 40rem) {
    .dir-row,
    .dir-row--flagship {
      grid-template-columns: minmax(0, 1fr);
    }

    .dir-row__thumb {
      max-width: 22rem;
    }
  }
</style>
