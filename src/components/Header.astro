---
import OpensInNewTab from "./OpensInNewTab.astro";

const navLinks = [
  { label: "Tools", href: "#tools" },
  { label: "About", href: "#about" },
  { label: "Contributors", href: "#contributors" },
  { label: "Contribute", href: "#community" },
];
---
<header class="masthead">
  <div class="container masthead__inner">
    <p class="masthead__issue">
      Student-run · Los Baños, Laguna · not an official UPLB website
    </p>
    <a href="/" class="masthead__wordmark" aria-label="uplb.tools home">
      uplb<span class="masthead__dot">.</span>tools
    </a>

    <nav class="masthead__nav" aria-label="Site">
      {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      <a
        href="https://github.com/uplbtools"
        target="_blank"
        rel="noopener noreferrer"
      >
        GitHub&nbsp;↗
        <OpensInNewTab />
      </a>
      <a href="https://room-tba.uplb.tools/donate" class="masthead__donate">
        Donate
      </a>
    </nav>

    <details class="masthead__menu">
      <summary>Menu</summary>
      <nav aria-label="Site">
        {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
        <a
          href="https://github.com/uplbtools"
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub&nbsp;↗
          <OpensInNewTab />
        </a>
        <a href="https://room-tba.uplb.tools/donate">Donate</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .masthead {
    padding-top: var(--space-lg);
    border-bottom: 4px double var(--border);
  }

  .masthead__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .masthead__issue {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-muted);
    margin-bottom: var(--space-2xs);
  }

  .masthead__wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.5rem, 7vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--text-ink);
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
  }

  .masthead__dot {
    color: var(--brand-maroon);
  }

  .masthead__nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    column-gap: var(--space-md);
    margin-top: var(--space-2xs);
  }

  .masthead__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-body);
    white-space: nowrap;
  }

  .masthead__nav a:hover {
    color: var(--brand-maroon);
  }

  .masthead__donate {
    color: var(--brand-maroon) !important;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }

  .masthead__menu {
    display: none;
  }

  @media (max-width: 40rem) {
    .masthead__nav {
      display: none;
    }

    .masthead__menu {
      display: block;
      width: 100%;
      margin-top: var(--space-2xs);
    }

    .masthead__menu summary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 2.75rem;
      padding: 0 var(--space-sm);
      font-size: var(--text-sm);
      font-weight: 600;
      color: var(--text-body);
      cursor: pointer;
      list-style: none;
    }

    .masthead__menu summary::-webkit-details-marker {
      display: none;
    }

    .masthead__menu summary::after {
      content: "▾";
      margin-left: 0.4ch;
      color: var(--brand-maroon);
    }

    .masthead__menu[open] summary::after {
      content: "▴";
    }

    .masthead__menu nav {
      display: flex;
      flex-direction: column;
      border-top: 1px solid var(--border-subtle);
    }

    .masthead__menu nav a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 2.75rem;
      font-size: var(--text-sm);
      font-weight: 600;
      color: var(--text-body);
    }
  }
</style>
