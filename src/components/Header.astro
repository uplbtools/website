---
import OpensInNewTab from "./OpensInNewTab.astro";

interface Props {
  /** Transparent header floated over the hero photo (home page). */
  overlay?: boolean;
}
const { overlay = false } = Astro.props;
---
<header class:list={["main-header", { "main-header--overlay": overlay }]}>
  <div class="container header-container">
    <a href="/" class="logo" aria-label="uplb.tools home">
      <img
        src="/icon.png"
        alt=""
        width="24"
        height="24"
        class="logo-icon"
        decoding="async"
        aria-hidden="true"
      />
      <span class="logo-word">uplb<span class="logo-dot">.</span>tools</span>
    </a>

    <nav class="header-nav" aria-label="Site">
      <a href="#tools" class="header-nav__link">Tools</a>
      <a href="#about" class="header-nav__link">About</a>
      <a href="#community" class="header-nav__link">Join</a>
      <a
        href="https://github.com/uplbtools"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-secondary btn-sm"
      >
        <img
          src="/brand/github.svg"
          alt=""
          width="14"
          height="14"
          class="header-github-icon"
          decoding="async"
          aria-hidden="true"
        />
        <span>GitHub</span>
        <OpensInNewTab />
      </a>
    </nav>
  </div>
</header>

<style>
  .main-header {
    position: sticky;
    top: 0;
    z-index: 200;
    min-height: var(--header-height);
    background-color: hsl(5 22% 96% / 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border-card);
  }

  /* Home page: the hero photo runs under the header, so the bar goes
     transparent and its text flips to white. Not sticky, the photo owns
     the top of the page. */
  .main-header--overlay {
    position: absolute;
    left: 0;
    right: 0;
    background-color: transparent;
    backdrop-filter: none;
    border-bottom: none;
  }

  .main-header--overlay .logo-word,
  .main-header--overlay .header-nav__link {
    color: #fff;
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.55);
  }

  .main-header--overlay .logo-dot {
    color: #ffd9a0;
  }

  .main-header--overlay :global(.btn-secondary) {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.7);
    background: rgba(255, 255, 255, 0.08);
  }

  .main-header--overlay .header-github-icon {
    filter: invert(1);
  }

  .header-container {
    min-height: var(--header-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .logo {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text-ink);
    white-space: nowrap;
    line-height: 1;
  }

  .logo-dot {
    color: var(--brand-maroon);
  }

  .logo-icon {
    width: 1.5rem;
    height: 1.5rem;
    object-fit: contain;
    flex-shrink: 0;
    display: block;
  }

  .header-nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .header-nav__link {
    display: none;
    min-height: 2.75rem;
    align-items: center;
    padding: 0 0.75rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-body);
    border-radius: var(--radius-pill);
  }

  .header-nav__link:hover {
    color: var(--brand-maroon);
    background: var(--brand-maroon-tint);
  }

  .header-github-icon {
    width: 0.875rem;
    height: 0.875rem;
    display: block;
    flex-shrink: 0;
  }

  @media (min-width: 640px) {
    .header-nav__link {
      display: inline-flex;
    }

    .header-nav .btn {
      margin-left: 0.5rem;
    }
  }
</style>
