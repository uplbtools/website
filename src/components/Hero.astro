<section class="intro" aria-labelledby="intro-title">
  <div class="container">
    <h1 id="intro-title" class="intro__title">
      Saan sa UPLB ang <span class="intro__blank">___</span>?
    </h1>
    <p class="intro__lede">
      Free, open-source tools for getting around UP Los Baños: a campus map
      that answers that question, a grade simulator, and whatever students
      build next. MIT-licensed code, CC-BY campus data, built and run by
      students.
    </p>
  </div>
</section>

<style>
  .intro {
    padding: var(--space-lg) 0 var(--space-xl);
    border-bottom: 1px solid var(--border-subtle);
  }

  .intro__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.75rem, 4.5vw, 2.5rem);
    line-height: 1.15;
    margin-bottom: var(--space-sm);
    text-wrap: balance;
  }

  .intro__blank {
    color: var(--brand-maroon);
  }

  .intro__lede {
    max-width: 42rem;
    font-size: var(--text-md);
  }
</style>
