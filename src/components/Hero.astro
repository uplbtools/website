---
import OpensInNewTab from "./OpensInNewTab.astro";
---
<section class="hero-section" aria-labelledby="hero-title">
  <img
    class="hero-photo"
    src="/uplb-hero.jpg"
    alt=""
    fetchpriority="high"
    width="1920"
    height="1280"
  />
  <div class="hero-shade" aria-hidden="true"></div>
  <a
    class="hero-credit"
    href="https://commons.wikimedia.org/wiki/File:Fertilty_Tree.jpg"
    target="_blank"
    rel="noopener noreferrer"
  >
    Fertility Tree photo: Klienneeco, CC BY-SA 4.0, color graded
  </a>
  <div class="container container--narrow hero-container">
    <h1 id="hero-title" class="hero-title">
      Free, open-source tools for UP Los Baños
    </h1>
    <p class="hero-lede">
      Room TBA, the campus map. Gawa ng isko't iska.
    </p>
    <p class="hero-sub">
      Plus food, housing, grades, and a campus directory, all built and run by
      UPLB students. No accounts, no tracking, code on GitHub.
    </p>
    <div class="hero-actions">
      <a
        href="https://room-tba.uplb.tools"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary"
      >
        Open Room TBA
        <OpensInNewTab />
      </a>
      <a href="#tools" class="btn btn-secondary">See all tools</a>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding: 4rem 0 3.5rem;
    border-bottom: 1px solid var(--border-card);
    overflow: hidden;
  }

  .hero-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 38%;
  }

  .hero-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(30, 8, 6, 0.32) 0%,
      rgba(30, 8, 6, 0.38) 55%,
      rgba(46, 10, 8, 0.62) 100%
    );
  }

  .hero-container {
    position: relative;
  }

  .hero-credit {
    position: absolute;
    right: 0.75rem;
    bottom: 0.5rem;
    z-index: 1;
    font-size: 0.6875rem;
    color: rgba(255, 255, 255, 0.75);
    text-decoration: none;
  }

  .hero-credit:hover {
    color: #fff;
    text-decoration: underline;
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 3rem);
    line-height: 1.05;
    font-weight: 800;
    color: #fff;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.45);
    text-wrap: balance;
  }

  .hero-lede {
    font-size: clamp(1.125rem, 2.5vw, 1.375rem);
    line-height: 1.4;
    color: #ffd9a0;
    font-weight: 600;
    text-shadow: 0 1px 14px rgba(0, 0, 0, 0.5);
    text-wrap: balance;
  }

  .hero-sub {
    font-size: 1rem;
    max-width: 36rem;
    color: rgba(255, 255, 255, 0.92);
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.5);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.75rem;
  }

  /* The default secondary button is ink-on-light and disappears on the
     photo; outline it in white inside the hero only. */
  .hero-actions :global(.btn-secondary) {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.7);
    background: rgba(255, 255, 255, 0.08);
  }

  .hero-actions :global(.btn-secondary:hover) {
    background: rgba(255, 255, 255, 0.18);
    border-color: #fff;
  }

  @media (min-width: 768px) {
    .hero-section {
      padding: 4.5rem 0 3.5rem;
    }
  }
</style>
