---
import OpensInNewTab from "./OpensInNewTab.astro";

const links = [
  {
    title: "GitHub",
    text: "Browse the code, pick up a good first issue, or open a pull request.",
    href: "https://github.com/uplbtools",
    label: "Open GitHub",
    primary: true,
  },
  {
    title: "Discord",
    text: "Ask questions, pitch an idea, or lurk. Dito nangyayari ang usapan.",
    href: "https://discord.uplbtools.me",
    label: "Join Discord",
    primary: false,
  },
  {
    title: "Messenger",
    text: "Group chat for quick coordination with the people already contributing.",
    href: "https://messenger.uplbtools.me",
    label: "Join the GC",
    primary: false,
  },
  {
    title: "Donate",
    text: "Not a coder? One-time donations pay for hosting and contributor payouts.",
    href: "https://room-tba.uplb.tools/donate",
    label: "Donate via PayMongo",
    primary: false,
  },
];
---
<section id="community" class="section community-section" aria-labelledby="community-heading">
  <div class="container">
    <div class="community-intro">
      <span class="section-eyebrow">Get involved</span>
      <h2 id="community-heading" class="section-title">Sali ka</h2>
      <p class="section-subtitle">
        Code, design, docs, or data entry. If you are a UPLB student and want to
        build something the campus actually uses, there is room for you.
      </p>
    </div>

    <ul class="community-links">
      {
        links.map((link) => (
          <li class="link-card card">
            <h3>{link.title}</h3>
            <p>{link.text}</p>
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class={`btn ${link.primary ? "btn-primary" : "btn-secondary"}`}
            >
              {link.label}
              <OpensInNewTab />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .community-intro {
    margin-bottom: 1.5rem;
  }

  .community-links {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    padding: 0;
    margin: 0;
  }

  .link-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem;
  }

  .link-card h3 {
    font-family: var(--font-display);
    font-size: 1.125rem;
  }

  .link-card p {
    font-size: 0.9375rem;
    flex: 1;
  }

  .link-card .btn {
    align-self: flex-start;
    margin-top: 0.5rem;
  }

  @media (min-width: 640px) {
    .community-links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .community-links {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
