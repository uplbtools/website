---
import OpensInNewTab from "./OpensInNewTab.astro";
---
<section id="community" class="section community-section" aria-labelledby="community-heading">
  <div class="container">
    <h2 id="community-heading" class="index-head">Contribute</h2>

    <div class="community-cols">
      <div class="community-roles">
        <p class="community-lede">
          Any UPLB student can contribute; you do not have to write code.
          Wrong campus data and QA reports count.
        </p>
        <dl class="roles">
          <div class="role">
            <dt>Software engineering</dt>
            <dd>
              Svelte, Astro, and browser-extension codebases with real review
              cycles and good-first-issue queues.
            </dd>
          </div>
          <div class="role">
            <dt>UI / UX design</dt>
            <dd>
              Wireframes, design tokens, accessibility passes across the tools.
            </dd>
          </div>
          <div class="role">
            <dt>Docs, data, and QA</dt>
            <dd>
              Fix a room schedule, verify a building pin, write a guide. The
              campus data is community-maintained.
            </dd>
          </div>
        </dl>
      </div>

      <div class="community-join">
        <a
          href="https://github.com/uplbtools"
          target="_blank"
          rel="noopener noreferrer"
          class="chip"
        >
          GitHub&nbsp;↗
          <OpensInNewTab />
        </a>
        <a
          href="https://discord.uplbtools.me"
          target="_blank"
          rel="noopener noreferrer"
          class="chip"
        >
          Discord&nbsp;↗
          <OpensInNewTab />
        </a>
        <a
          href="https://messenger.uplbtools.me"
          target="_blank"
          rel="noopener noreferrer"
          class="chip"
        >
          Messenger&nbsp;GC&nbsp;↗
          <OpensInNewTab />
        </a>
        <a
          href="https://room-tba.uplb.tools/donate"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-fill"
        >
          Donate
          <OpensInNewTab />
        </a>
        <p class="community-donate-note">
          One-time donations via GCash or any QR Ph app cover hosting and
          contributor payouts for every UPLB Tools project.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .community-section {
    border-bottom: 1px solid var(--border-subtle);
  }

  .community-cols {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: var(--space-xl);
    align-items: start;
  }

  .community-lede {
    font-size: var(--text-md);
    max-width: 36rem;
    margin-bottom: var(--space-md);
  }

  .roles {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .role dt {
    font-weight: 700;
    font-size: var(--text-sm);
    color: var(--text-ink);
    margin-bottom: var(--space-3xs);
  }

  .role dd {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .community-join {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-2xs);
  }

  .community-donate-note {
    font-size: var(--text-xs);
    color: var(--text-muted);
    line-height: 1.5;
  }

  @media (max-width: 48rem) {
    .community-cols {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-lg);
    }

    .community-join {
      max-width: 22rem;
    }
  }
</style>
