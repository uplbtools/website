---
import OpensInNewTab from "./OpensInNewTab.astro";

const year = new Date().getFullYear();
---
<footer class="colophon">
  <div class="container">
    <p class="colophon__block">
      <strong>uplb.tools</strong> — free tools for UP Los Baños, built and run
      by students. Independent project; not affiliated with, endorsed by, or
      representing the UPLB administration. Application code
      <a href="https://github.com/uplbtools/room-tba/blob/main/LICENSE">MIT</a>;
      community campus map data
      <a href="https://creativecommons.org/licenses/by/4.0/">CC-BY&nbsp;4.0</a>;
      basemap ©&nbsp;<a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>
      contributors. ©&nbsp;{year} UPLB Tools.
      <a href="/privacy">Privacy</a> ·
      <a href="/terms">Terms</a> ·
      <a
        href="https://github.com/uplbtools/uplbtools.me"
        target="_blank"
        rel="noopener noreferrer"
        >site source&nbsp;↗<OpensInNewTab /></a
      > ·
      <a
        href="https://room-tba.uplb.tools/donate"
        target="_blank"
        rel="noopener noreferrer"
        >donate&nbsp;↗<OpensInNewTab /></a
      >
    </p>
  </div>
</footer>

<style>
  .colophon {
    border-top: 1px solid var(--border-subtle);
    padding: var(--space-lg) 0 var(--space-xl);
  }

  .colophon__block {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.9;
    color: var(--text-muted);
    max-width: 40rem;
  }

  .colophon__block strong {
    color: var(--text-ink);
    font-weight: 600;
  }

  .colophon__block a {
    display: inline-block;
    color: var(--text-body);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
    padding: var(--space-3xs) 0;
  }

  .colophon__block a:active {
    color: var(--brand-maroon-deep);
  }

  .colophon__block a:hover {
    color: var(--brand-maroon);
  }
</style>
