---
import OpensInNewTab from "./OpensInNewTab.astro";
---
<footer class="main-footer">
  <div class="container footer-container">
    <div class="footer-brand-side">
      <a href="/" class="logo" aria-label="uplb.tools home">
        <img
          src="/icon.png"
          alt=""
          width="32"
          height="32"
          class="logo-icon"
          decoding="async"
          aria-hidden="true"
        />
        <span class="logo-word">uplb<span class="logo-dot">.</span>tools</span>
      </a>
      <p class="brand-pitch">
        Free, open-source tools for the students of the University of the
        Philippines Los Baños. Gawa ng isko't iska.
      </p>
    </div>

    <div class="footer-links-side">
      <nav class="footer-nav" aria-label="Page sections">
        <h2 class="footer-heading">On this page</h2>
        <a href="#tools">Tools</a>
        <a href="#about">About</a>
        <a href="#contributors">Contributors</a>
        <a href="#community">Join</a>
      </nav>

      <nav class="footer-nav" aria-label="Resources">
        <h2 class="footer-heading">More</h2>
        <a href="/about">About us</a>
        <a href="/people">People</a>
        <a href="/press">Press kit</a>
        <a href="/privacy">Privacy policy</a>
        <a href="/terms">Terms of use</a>
        <a href="https://room-tba.uplb.tools/donate">Donate</a>
        <a
          href="https://github.com/uplbtools"
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub organization
          <OpensInNewTab />
        </a>
        <a
          href="https://github.com/uplbtools/website"
          target="_blank"
          rel="noopener noreferrer"
        >
          Website source
          <OpensInNewTab />
        </a>
      </nav>
    </div>
  </div>

  <div class="container footer-bottom">
    <p class="disclaimer">
      uplb.tools is an independent, student-led open-source project. It is not
      affiliated with, endorsed by, or representing the University of the
      Philippines Los Baños administration.
    </p>
    <p class="copyright">
      &copy; {new Date().getFullYear()} uplb.tools. Built by Elbi student developers.
    </p>
  </div>
</footer>

<style>
  .main-footer {
    border-top: 1px solid var(--border-card);
    background-color: var(--bg-card);
    padding: 3rem 0 2rem;
  }

  .footer-container {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-bottom: 2.5rem;
  }

  .footer-brand-side {
    max-width: 24rem;
  }

  .logo {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.2rem;
    letter-spacing: -0.02em;
    color: var(--text-ink);
    margin-bottom: 0.5rem;
  }

  .logo-icon {
    width: 2rem;
    height: 2rem;
    object-fit: contain;
    flex-shrink: 0;
  }

  .logo-dot {
    color: var(--brand-maroon);
  }

  .brand-pitch {
    font-size: 0.9375rem;
    color: var(--text-muted);
  }

  .footer-links-side {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem 3.5rem;
  }

  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .footer-heading {
    font-size: 0.9375rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
    font-family: var(--font-display);
    color: var(--text-ink);
  }

  .footer-nav a {
    display: inline-flex;
    min-height: 2.5rem;
    align-items: center;
    font-size: 0.9375rem;
    color: var(--text-body);
  }

  .footer-nav a:hover {
    color: var(--brand-maroon);
    text-decoration: underline;
  }

  .footer-bottom {
    border-top: 1px solid var(--border-card);
    padding-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .disclaimer {
    max-width: var(--measure);
    font-size: 0.8125rem;
    color: var(--text-muted);
    line-height: 1.55;
  }

  .copyright {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  @media (min-width: 768px) {
    .main-footer {
      padding-top: 4rem;
    }

    .footer-container {
      flex-direction: row;
      justify-content: space-between;
      gap: 3rem;
    }
  }
</style>
