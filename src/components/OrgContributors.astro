---
import {
  fetchOrgTopContributors,
  formatGithubContributions,
} from "../lib/github-org-contributors";
import OpensInNewTab from "./OpensInNewTab.astro";

const TOP_CONTRIBUTOR_COUNT = 12;

let contributors: Awaited<ReturnType<typeof fetchOrgTopContributors>> = [];
let loadError: string | null = null;

try {
  contributors = await fetchOrgTopContributors(TOP_CONTRIBUTOR_COUNT);
} catch {
  loadError = "Could not load contributors from GitHub during the last build.";
}
---

<section id="contributors" class="section staff-section" aria-labelledby="contributors-heading">
  <div class="container">
    <h2 id="contributors-heading" class="index-head">Contributors</h2>
    <p class="staff-note">
      Commit history across public <code>uplbtools</code> repositories, bots
      filtered out.
      <a
        href="https://github.com/uplbtools"
        target="_blank"
        rel="noopener noreferrer"
        class="tlink"
        >Full list on GitHub&nbsp;↗<OpensInNewTab /></a
      >
    </p>

    {
      loadError ? (
        <p class="staff-status" role="alert">
          {loadError}
        </p>
      ) : contributors.length === 0 ? (
        <p class="staff-status" role="status">
          No public contributors found yet. Check back after the next deploy.
        </p>
      ) : (
        <ul class="staff-list">
          {contributors.map((person) => {
            const displayName = person.name ?? person.login;
            const commits = formatGithubContributions(person.contributions);
            return (
              <li>
                <a
                  class="staff-row"
                  href={person.profileUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${displayName}, ${commits} across uplbtools repositories on GitHub`}
                >
                  <img
                    src={person.avatarUrl}
                    alt=""
                    width="28"
                    height="28"
                    loading="lazy"
                    decoding="async"
                    class="staff-row__avatar"
                    aria-hidden="true"
                  />
                  <span class="staff-row__name">{displayName}</span>
                  <span class="staff-row__commits">{commits}</span>
                  <OpensInNewTab />
                </a>
              </li>
            );
          })}
        </ul>
      )
    }
  </div>
</section>

<style>
  .staff-section {
    border-bottom: 1px solid var(--border-subtle);
  }

  .staff-note {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin-bottom: var(--space-md);
  }

  .staff-note code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--brand-maroon);
  }

  .staff-note .tlink {
    min-height: 0;
    margin-left: 0.5ch;
  }

  .staff-status {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .staff-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    column-gap: var(--space-md);
  }

  .staff-row {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    min-height: 2.75rem;
    padding: var(--space-3xs) 0;
    border-bottom: 1px solid var(--border-subtle);
    font-size: var(--text-sm);
  }

  .staff-row:hover .staff-row__name {
    color: var(--brand-maroon);
  }

  .staff-row__avatar {
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 999px;
    object-fit: cover;
    border: 1px solid var(--border-subtle);
    flex-shrink: 0;
  }

  .staff-row__name {
    font-weight: 600;
    color: var(--text-ink);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
  }

  .staff-row__commits {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
    white-space: nowrap;
  }
</style>
