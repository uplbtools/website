---
import {
  fetchOrgTopContributors,
  formatGithubContributions,
} from "../lib/github-org-contributors";
import OpensInNewTab from "./OpensInNewTab.astro";

const TOP_CONTRIBUTOR_COUNT = 12;

let contributors: Awaited<ReturnType<typeof fetchOrgTopContributors>> = [];
let loadError: string | null = null;

try {
  contributors = await fetchOrgTopContributors(TOP_CONTRIBUTOR_COUNT);
} catch {
  loadError = "Could not load contributors from GitHub during the last build.";
}
---

<section id="contributors" class="section contributors-section" aria-labelledby="contributors-heading">
  <div class="container">
    <div class="contributors-header">
      <div>
        <span class="section-eyebrow">The people</span>
        <h2 id="contributors-heading" class="section-title">Top contributors</h2>
        <p class="section-subtitle">
          Commits across public uplbtools repositories on GitHub. Bots are
          filtered out.
        </p>
      </div>
      <a
        href="https://github.com/uplbtools"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-secondary"
        aria-label="View uplbtools organization on GitHub"
      >
        View org on GitHub
        <OpensInNewTab />
      </a>
    </div>

    {
      loadError ? (
        <p class="contributors-status contributors-status--error" role="alert">
          {loadError}
        </p>
      ) : contributors.length === 0 ? (
        <p class="contributors-status" role="status">
          No public contributors found yet. Check back after the next deploy.
        </p>
      ) : (
        <ul class="contributors-grid">
          {contributors.map((person) => {
            const displayName = person.name ?? person.login;
            const commits = formatGithubContributions(person.contributions);
            return (
              <li>
                <a
                  class="contributor-card card"
                  href={person.profileUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${displayName}, ${commits} across uplbtools repositories on GitHub`}
                >
                  <img
                    src={person.avatarUrl}
                    alt=""
                    width="64"
                    height="64"
                    loading="lazy"
                    decoding="async"
                    class="contributor-card__avatar"
                    aria-hidden="true"
                  />
                  <span class="contributor-card__name">{displayName}</span>
                  {person.name ? (
                    <span class="contributor-card__login">@{person.login}</span>
                  ) : null}
                  <span class="contributor-card__commits">{commits}</span>
                  <OpensInNewTab />
                </a>
              </li>
            );
          })}
        </ul>
      )
    }
  </div>
</section>

<style>
  .contributors-section {
    border-bottom: 1px solid var(--border-card);
  }

  .contributors-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .contributors-status {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--text-muted);
  }

  .contributors-status--error {
    color: hsl(0, 72%, 35%);
  }

  .contributors-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
  }

  .contributor-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1rem 0.5rem;
    gap: 0.2rem;
    height: 100%;
  }

  .contributor-card:hover {
    border-color: var(--brand-maroon-line);
    background: var(--brand-maroon-tint);
  }

  .contributor-card__avatar {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: var(--radius-pill);
    object-fit: cover;
    border: 2px solid var(--bg-elevated);
    /* Ring plus a soft drop, so the avatar sits on the card rather than
       being punched into it. The tint also stands in while the image is
       still lazy-loading, instead of an empty outline. */
    box-shadow:
      0 0 0 1px var(--border-card),
      var(--shadow-sm);
    background: var(--bg-page);
    margin-bottom: 0.45rem;
  }

  .contributor-card__name {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--text-ink);
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .contributor-card__login {
    font-size: 0.75rem;
    color: var(--text-muted);
    overflow-wrap: anywhere;
  }

  .contributor-card__commits {
    margin-top: 0.15rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--brand-maroon);
    font-variant-numeric: tabular-nums;
  }

  @media (min-width: 480px) {
    .contributors-grid {
      grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    }
  }
</style>
